# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / local
.vscode/*
!.vscode/extensions.json
.claude/settings.local.json

# Material fuente (brochures, logos) — se guarda en local, demasiado pesado para git
imagenes

# 3D: modelos de origen pesados e intermedios (ver docs/ARQUITECTURA_MODELO_3D.md)
/3d/fuentes/
/3d/salida/

# Capturas de verificación y medición del 3D (docs/landing/cuerpo-unico/):
# son resultados de los scripts de esa carpeta, se regeneran y pesaban 60 MB.
# Quedan en local (y en el historial hasta el 2026-11-02); en git van los
# scripts, las mediciones (.json) y los textos.
/docs/landing/cuerpo-unico/**/*.webp
/docs/landing/cuerpo-unico/**/*.png

# Capturas de comparación de los textos editables (docs/landing/textos-editables/):
# se regeneran con los scripts de esa carpeta; en git van los scripts y los textos.
/docs/landing/textos-editables/**/*.webp
/docs/landing/textos-editables/**/*.png
# Las corridas de comparación (nueva*, diff*) se regeneran con capturar.mjs;
# en git quedan solo la base (los textos de referencia) y los scripts.
/docs/landing/textos-editables/capturas/nueva*/
/docs/landing/textos-editables/capturas/diff*/
/docs/landing/textos-editables/capturas/base/*.json

# Tutorial de los editores (docs/tutorial-editores/): las capturas, el perfil de
# Chrome con la sesión de Keystatic Cloud y el PDF se regeneran; en git van el
# guion, los prompts y los scripts.
/docs/tutorial-editores/capturas/
/docs/tutorial-editores/.perfil/
/docs/tutorial-editores/salida/

# Onboarding de Innercare (docs/onboarding/): el PDF se regenera.
/docs/onboarding/salida/
